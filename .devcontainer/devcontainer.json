{
  "name": "TurboDiffusion",
  "image": "nvcr.io/nvidia/pytorch:25.04-py3",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "pip install -e '.[dev]' && pip install onnx onnxscript onnxruntime-gpu",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "runArgs": [
    "--gpus=all",
    "--shm-size=16g"
  ]
}
